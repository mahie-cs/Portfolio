# Public URL used for metadata, sitemap and OG images
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form SMTP configuration (Gmail)
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_USER=your-email@gmail.com
NODEMAILER_PASS=your-16-character-app-password
USER_MAILER=your-email@gmail.com
USER_TO=your-email@gmail.com

# Optional: raises the GitHub API rate limit for /stats
GITHUB_TOKEN=

# Optional: Google Analytics measurement ID
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
